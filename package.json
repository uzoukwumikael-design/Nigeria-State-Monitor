{
  "name": "nigeria-state-monitor",
  "version": "0.2.0",
  "private": true,
  "description": "AI-powered national intelligence, geospatial monitoring and economic intelligence for Nigeria.",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "geo:build": "node scripts/build-geo.mjs",
    "geo:verify": "node scripts/verify-geo.mjs",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:rollback": "tsx scripts/db/rollback.ts",
    "db:seed-registry": "tsx scripts/db/seed-registry.ts",
    "db:seed-demo": "tsx scripts/db/seed-demo.ts",
    "db:doctor": "tsx scripts/db/doctor.ts",
    "db:verify": "tsx scripts/db/verify.ts",
    "db:verify:demo": "tsx scripts/db/verify.ts --expect=demo",
    "db:verify:registry": "tsx scripts/db/verify.ts --expect=registry",
    "db:verify:local": "tsx scripts/db/verify-local.ts",
    "db:setup": "npm run db:migrate && npm run db:seed-demo && npm run db:verify -- --expect=demo",
    "db:setup:registry": "npm run db:migrate && npm run db:seed-registry && npm run db:verify -- --expect=registry",
    "ingest": "tsx scripts/ingest/run.ts",
    "ingest:dry-run": "tsx scripts/ingest/run.ts --source=all --dry-run",
    "ingest:local": "tsx scripts/ingest/run.ts --source=all --pglite",
    "review": "tsx scripts/review/run.ts",
    "enrich": "tsx scripts/enrich/run.ts",
    "cluster": "tsx scripts/cluster/run.ts",
    "publish": "tsx scripts/publish/run.ts",
    "verification": "tsx scripts/verification/run.ts",
    "scheduler": "tsx scripts/scheduler/run.ts",
    "sources:check": "tsx scripts/sources/check.ts",
    "ingest:all": "tsx scripts/ingest/run.ts --source=all",
    "autopilot": "tsx scripts/autopilot/run.ts",
    "sources:add": "tsx scripts/sources/add.ts",
    "golive:check": "tsx scripts/golive/check.ts",
    "secrets:generate": "tsx scripts/golive/secrets.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@maplibre/maplibre-gl-style-spec": "^26.5.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^6.16.0",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.10.1",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-postgis": "^0.2.15",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.28",
    "jsdom": "^27.0.0",
    "polylabel": "^2.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
