# Nigeria State Monitor — environment variables
# Copy to .env.local. Never commit secrets.
# The default demo dashboard runs without any database.

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "demo" (default) or "production".
# Production must use the Postgres repository and rejects demo rows.
NSM_MODE=demo

# "memory" (default in demo mode) or "postgres".
# Production always requires "postgres" and a DATABASE_URL.
# Use "postgres" with a seeded demo database to run the API through SQL locally.
NSM_REPOSITORY=memory

# Phase 4 — server-only PostgreSQL/PostGIS.
# Runtime connection. For Supabase serverless/Vercel use the shared transaction
# pooler (port 6543). For a persistent server the direct/session URL also works.
# Never expose this value to the browser or prefix it with NEXT_PUBLIC_.
DATABASE_URL=

# Admin connection for migrations, rollbacks, seeds, doctor and verify.
# Use the Supabase shared session pooler (port 5432) or a direct connection.
# Falls back to DATABASE_URL when omitted. Never expose this value to the client.
MIGRATION_DATABASE_URL=

# disable | require | verify-full. Leave blank to infer: Supabase hosts are
# encrypted without CA verification, local Postgres uses no SSL.
# Use verify-full with DATABASE_SSL_CA for production certificate validation.
DATABASE_SSL=

# Optional PEM root certificate path for DATABASE_SSL=verify-full.
DATABASE_SSL_CA=

# NSM installs PostGIS in the Supabase `extensions` schema. Runtime SQL qualifies
# PostGIS calls, so this option is only applied to direct/session connections.
DATABASE_SEARCH_PATH=public,extensions

# pg pool size per process (1–20). Use 1 on serverless platforms such as Vercel.
DATABASE_POOL_MAX=5

# Supabase browser/API credentials are reserved for later phases; the current
# repository uses DATABASE_URL and does not read these. Never put the service
# role key or a database URL in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 5 — AI enrichment provider (server-only; never prefix with NEXT_PUBLIC_).
# "disabled" (default, no model call), "openai" or "openai-compatible".
# Any other value fails loudly with AiConfigurationError; there is no silent fallback.
AI_PROVIDER=disabled
# Required for "openai-compatible" (HTTPS only). Optional for "openai".
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional tuning.
AI_TIMEOUT_MS=
AI_MAX_OUTPUT_TOKENS=
# Force JSON response mode for compatible endpoints ("true"); always on for "openai".
AI_JSON_MODE=
# Loopback-only escape hatch for a local http:// server (e.g. Ollama). Never in production.
AI_ALLOW_INSECURE_BASE_URL=
# Not read by this build (reserved for future provider adapters).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
HF_API_TOKEN=
HF_MODEL=

# Phase 5 — ingestion
# Optional contact included in the truthful User-Agent for feed requests.
NSM_INGESTION_CONTACT=
# Sources ingested by the scheduled endpoint and the CLI: "all" (default), one slug, or a comma list.
# Registered (18): premium-times, channels-tv, punch, vanguard, daily-trust, businessday, nigerian-tribune,
# daily-post, blueprint, leadership, pm-news, ripples-nigeria, the-will, information-ng, point-blank-news,
# hallmark, the-tide, herald. Every source is checked against its robots.txt on every run; a source that is
# blocked, down or broken is skipped and reported, and never stops the others.
# The cron route also accepts ?source=punch,vanguard so you can schedule publishers separately.
INGESTION_SOURCE=all

# Phase 5 — reviewer console (/review) and review APIs. Server-only.
# Comma-separated reviewer-id:secret pairs. Each secret needs 24+ characters, no spaces.
# Example: duty.editor:<24+ random chars>,second.editor:<24+ random chars>
REVIEWER_CREDENTIALS=
# Signs reviewer session cookies. 32+ characters, no spaces. Generate with: openssl rand -hex 32
REVIEWER_SESSION_SECRET=

# Phase 5 — scheduled ingestion (/api/cron/ingest). Server-only.
# Bearer token the scheduler must send. 16+ characters. Without it the endpoint returns 503.
CRON_SECRET=
# Lease length for the ingestion lock, 30–3600 seconds (default 300).
SCHEDULER_LOCK_TTL_SECONDS=300

# Rate limiting (optional). With both set, limits are shared across serverless instances
# via Upstash Redis REST (https only). Without them, a per-instance in-memory limiter is
# used; if Upstash is configured but unreachable, the app falls back to that limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Economic indicators (World Bank WDI). Optional override; only https://api.worldbank.org
# is accepted — any other host is refused at startup of the request.
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2

# Automatic publishing (see docs/AUTOPUBLISHING.md). On by default; set AUTOPUBLISH=off to stop all
# automatic accepting, declining and publishing. Ingestion still runs.
AUTOPUBLISH=on
# Optional tuning (defaults shown).
AUTOPUBLISH_MIN_CATEGORY_CONFIDENCE=0.5
AUTOPUBLISH_MIN_GEO_CONFIDENCE=0.6
AUTOPUBLISH_MIN_AI_CONFIDENCE=0.7
AUTOPUBLISH_MAX_PER_RUN=30
# Paid AI calls per run when AI_PROVIDER is configured.
AUTOPUBLISH_AI_PER_RUN=10

# Switch sources off without touching code, e.g. when a publisher objects. Comma-separated slugs (see the Sources tab).
INGESTION_DISABLE=

# How many characters of publisher text may appear on the site (0-400). Default 0: events show the headline, the outlet
# and a link only. Raise it only after you have the publisher's written permission (see docs/TERMS_REVIEW.md).
PUBLISHED_EXCERPT_CHARS=0
